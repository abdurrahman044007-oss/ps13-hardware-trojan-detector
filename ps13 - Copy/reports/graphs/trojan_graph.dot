digraph Circuit {
    rankdir=LR;
    node [fontname="Arial"];
    "gate_U1" [shape=box, label="U1\nAND"];
    "net_n1" [shape=ellipse, label="n1"];
    "gate_U1" -> "net_n1";
    "net_a" [shape=ellipse, label="a"];
    "net_a" -> "gate_U1";
    "net_b" [shape=ellipse, label="b"];
    "net_b" -> "gate_U1";
    "gate_U2" [shape=box, label="U2\nOR"];
    "net_n2" [shape=ellipse, label="n2"];
    "gate_U2" -> "net_n2";
    "net_n1" [shape=ellipse, label="n1"];
    "net_n1" -> "gate_U2";
    "net_c" [shape=ellipse, label="c"];
    "net_c" -> "gate_U2";
    "gate_U3" [shape=box, label="U3\nNOT"];
    "net_normal_y" [shape=ellipse, label="normal_y"];
    "gate_U3" -> "net_normal_y";
    "net_n2" [shape=ellipse, label="n2"];
    "net_n2" -> "gate_U3";
    "gate_T1" [shape=box, label="T1\nAND"];
    "net_trigger" [shape=ellipse, label="trigger"];
    "gate_T1" -> "net_trigger";
    "net_a" [shape=ellipse, label="a"];
    "net_a" -> "gate_T1";
    "net_b" [shape=ellipse, label="b"];
    "net_b" -> "gate_T1";
    "net_c" [shape=ellipse, label="c"];
    "net_c" -> "gate_T1";
    "net_d" [shape=ellipse, label="d"];
    "net_d" -> "gate_T1";
    "net_e" [shape=ellipse, label="e"];
    "net_e" -> "gate_T1";
    "net_f" [shape=ellipse, label="f"];
    "net_f" -> "gate_T1";
    "net_g" [shape=ellipse, label="g"];
    "net_g" -> "gate_T1";
    "net_h" [shape=ellipse, label="h"];
    "net_h" -> "gate_T1";
    "gate_T2" [shape=box, label="T2\nXOR"];
    "net_y" [shape=ellipse, label="y"];
    "gate_T2" -> "net_y";
    "net_normal_y" [shape=ellipse, label="normal_y"];
    "net_normal_y" -> "gate_T2";
    "net_trigger" [shape=ellipse, label="trigger"];
    "net_trigger" -> "gate_T2";
}