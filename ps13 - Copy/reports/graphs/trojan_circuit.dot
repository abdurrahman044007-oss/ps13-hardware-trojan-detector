digraph Circuit {
    rankdir=LR;
    "U1" [shape=box, label="U1\nAND"];
    "a" -> "U1";
    "b" -> "U1";
    "U1" -> "n1";
    "U2" [shape=box, label="U2\nOR"];
    "n1" -> "U2";
    "c" -> "U2";
    "U2" -> "n2";
    "U3" [shape=box, label="U3\nNOT"];
    "n2" -> "U3";
    "U3" -> "normal_y";
    "T1" [shape=box, label="T1\nAND"];
    "a" -> "T1";
    "b" -> "T1";
    "c" -> "T1";
    "d" -> "T1";
    "e" -> "T1";
    "f" -> "T1";
    "g" -> "T1";
    "h" -> "T1";
    "T1" -> "trigger";
    "T2" [shape=box, label="T2\nXOR"];
    "normal_y" -> "T2";
    "trigger" -> "T2";
    "T2" -> "y";
}